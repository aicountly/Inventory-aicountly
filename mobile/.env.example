# ---------------------------------------------------------------------------
# Inventory mobile — Expo build environment template
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored and is NEVER committed.
#
# IMPORTANT — these values are read at BUILD time, not at run time. Metro
# inlines every EXPO_PUBLIC_* value into the JS bundle, the same way Vite
# inlines VITE_* for web/ (see web/.env.example). Never put a secret here —
# anything EXPO_PUBLIC_* is public once built.
# ---------------------------------------------------------------------------

# --- API endpoint ------------------------------------------------------------
# Base URL of this product's PHP API. Unlike web/, there is no same-origin
# fallback on mobile, so this must be set explicitly.
#
#   https://inventory.aicountly.com/api        (production)
#   https://inventory.gh.aicountly.com/api     (sandbox)
EXPO_PUBLIC_API_BASE_URL=https://inventory.gh.aicountly.com/api

# --- App identity --------------------------------------------------------------
EXPO_PUBLIC_APP_NAME=Inventory

# Deploy target this build is for: local | sandbox | production
EXPO_PUBLIC_APP_ENV=local

# --- Authentication ------------------------------------------------------------
# Login portal origin. Production is https://my.aicountly.com and sandbox is
# https://sandbox.aicountly.com. See docs/auth/AICOUNTLY_AUTH_WORKFLOW.md —
# the interactive login flow itself is not implemented yet (src/auth/tokens.ts).
EXPO_PUBLIC_PORTAL_LOGIN_URL=https://sandbox.aicountly.com
