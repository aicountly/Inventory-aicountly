# ---------------------------------------------------------------------------
# Inventory — React build environment template
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored and is NEVER committed or deployed.
#
# IMPORTANT — these values are read at BUILD time, not at run time.
# Vite inlines every VITE_* value into the JavaScript bundle when the app is
# built. Putting a .env on the cPanel server has NO effect on an already-built
# app: the bundle is plain static JS and never reads a file from disk. To change
# an endpoint you must rebuild and redeploy.
# (server-php is the opposite — that backend does read its own .env at runtime.
# Its template is server-php/.env.example.)
#
# Never put a secret here — anything VITE_* is public once built.
# ---------------------------------------------------------------------------

# --- API endpoint ----------------------------------------------------------
# Base URL of this product's PHP API.
#
# Leave it EMPTY and the app calls its own origin + /api, which is exactly where
# the API workflows deploy server-php:
#
#   https://inventory.aicountly.com/api        (production)
#   https://inventory.gh.aicountly.com/api     (sandbox)
#
# Set it only to point somewhere else — a separate API domain, or a deployed
# sandbox API while running `npm run dev` locally. In CI the same override is
# available as the optional repository variables PROD_API_BASE_URL and
# SANDBOX_API_BASE_URL (Settings > Secrets and variables > Actions > Variables).
VITE_API_BASE_URL=https://inventory.gh.aicountly.com/api

# --- App identity ----------------------------------------------------------
# Display name shown in the UI.
VITE_APP_NAME=Inventory

# Deploy target this build is for: local | sandbox | production
VITE_APP_ENV=local

# --- Authentication --------------------------------------------------------
# Both of these are normally derived from the hostname and should stay unset.
# They exist for local development, where the hostname says nothing about the
# product or the environment.
#
# Portal authentication_jump product key. Derived from the hostname in the
# deployed environments (inventory.aicountly.com and inventory.gh.aicountly.com both
# give "inventory").
# VITE_PRODUCT_KEY=inventory
#
# Login portal origin. Production is https://my.aicountly.com and sandbox is
# https://sandbox.aicountly.com; localhost uses the sandbox portal.
# NOTE: this is the login redirect only. The auth API (seskey, refresh,
# validatesession) is always my.aicountly.com — see docs/auth/.
# VITE_PORTAL_LOGIN_URL=https://sandbox.aicountly.com

# --- Analytics ---------------------------------------------------------------
# GA4 (gtag) measurement ID for this product, e.g. G-XXXXXXXXXX. Leave empty to
# disable analytics (no script is injected). The marketing portal reads traffic
# for this property server-side via GA4_PROPERTY_ID_SAAS_INVENTORY.
VITE_GA4_SAAS_INVENTORY_MEASUREMENT_ID=
#
# Generic fallback, used only if the product-specific ID above is unset.
# VITE_GA4_MEASUREMENT_ID=

# --- Aicountly AI (optional) -------------------------------------------------
# API path that answers Aicountly AI requests, relative to VITE_API_BASE_URL
# (for example v1/ai/suggest).
#
# Leave it EMPTY — the default — until the service exists. The AI panels on the
# masters screens then offer themselves as "not yet connected" and every button
# on those screens keeps working; the deterministic findings beside them are
# counted in the browser and are labelled as derived, not as a model's answer.
# Nothing anywhere fabricates a model answer when this is unset.
VITE_INVENTORY_AI_PATH=

# --- Feature flags ---------------------------------------------------------
# Optional parts of a screen (src/config/features.ts). Every one defaults ON;
# set a flag to 0/false/off to take that capability out of a build. Every screen
# still works with all of them off, and nothing a flag hides is the only way to
# reach an action.
#
# VITE_FEATURE_JOB_WORK_ASSISTANT=1        right-hand rail on the job-work screens
# VITE_FEATURE_JOB_WORK_SMART_WARNINGS=1   contextual notes beside the job-work form
# VITE_FEATURE_JOB_WORK_TIMELINE=1         settlement trail behind one pending quantity
# VITE_FEATURE_JOB_WORK_IMPORT=1           paste / template import of job-work lines
# VITE_FEATURE_JOB_WORK_BARCODE_SCAN=1     barcode entry on the job-work grid

# ---------------------------------------------------------------------------
# Material receipt integrations (web)
# ---------------------------------------------------------------------------
# Each of these turns on a workflow on Documents -> Material Receipt that reads
# another product over a LIVE API through Inventory's own relay. Nothing here
# copies another product's data into inv_* and nothing is synchronised by cron.
# Leave a flag unset until the matching relay exists in server-php: the button
# then stays visible and disabled with the reason on it, rather than opening a
# workflow that cannot answer. See web/src/documents/receipt/integrations.ts.
#
# GET /v1/purchases/purchase-orders[/{id}/receivable] - Create from PO
# VITE_FEATURE_RECEIPT_PURCHASE_ORDERS=1
# POST /v1/ai/invoice-extract (multipart) - read a supplier invoice
# VITE_FEATURE_RECEIPT_AI_AUTOFILL=1
# /v1/inventory-documents/{id}/attachments - supplier invoice / challan files
# VITE_FEATURE_RECEIPT_ATTACHMENTS=1
