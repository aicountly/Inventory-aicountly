# -------------------------------------------------------
# AICOUNTLY Inventory API — CodeIgniter 4 environment file
# Copy to .env on the server. .env is never committed or deployed.
# -------------------------------------------------------
CI_ENVIRONMENT = production

# Must include the /api/ path — CI4 is deployed in the api/ folder under the site root.
# Sandbox:    https://inventory.gh.aicountly.com/api/
# Production: https://inventory.aicountly.com/api/
app.baseURL = 'https://inventory.gh.aicountly.com/api/'
INVENTORY_APP_URL = https://inventory.gh.aicountly.com/

# -------------------------------------------------------
# Database — PostgreSQL only (inv_* tables). Never MySQL/SQLite in runtime.
# cPanel prefixes database and user with the account name.
# -------------------------------------------------------
database.default.hostname = 127.0.0.200
database.default.username = ghinventoryaicountly_inventory_user
database.default.password = YOUR_DB_PASSWORD
database.default.database = ghinventoryaicountly_inventory
database.default.DBDriver = Postgre
database.default.port     = 5432
database.default.schema   = public
database.default.DBDebug  = false

# -------------------------------------------------------
# Portal auth (ses_key validation). Always my.aicountly.com.
# -------------------------------------------------------
# PORTAL_AUTH_BASE = https://my.aicountly.com

# Manage product API (company / branch / FY truth). Resolved from the request host
# (inventory.gh.* -> manage.gh.*); override only when needed.
# MANAGE_API_BASE = https://manage.gh.aicountly.com

# -------------------------------------------------------
# Service-to-service trust (Books, Sales, Purchases, POS, Billing -> Inventory).
# A caller presenting X-Service-Key with one of these keys is a trusted product
# backend; it must also send X-Actor-Uuid (the human behind the call, for audit)
# and X-Source-App (books|sales|purchases|pos|billing). Comma separated
# "app:key" pairs. Rotate by adding the new pair, deploying both sides, then removing the old one.
# -------------------------------------------------------
INVENTORY_SERVICE_KEYS = books:CHANGE_ME_BOOKS_SERVICE_KEY

# Books integration endpoint used for accounting events / valuation revisions (outbox target).
# Resolved from host (inventory.gh.* -> books.gh.*); override only when needed.
# BOOKS_API_BASE = https://books.gh.aicountly.com/api
# Service key Inventory presents to Books (must match BOOKS_INVENTORY_SERVICE_KEY in Books .env)
BOOKS_SERVICE_KEY = CHANGE_ME_INVENTORY_TO_BOOKS_SERVICE_KEY

# TEMPORARY access bypass (must be 0 in production)
INVENTORY_ACCESS_BYPASS=0

# --- Books source database for `php spark inventory:migrate-books` (read-only) ---
# BOOKS_DB_HOST = 127.0.0.1
# BOOKS_DB_PORT = 5432
# BOOKS_DB_NAME =
# BOOKS_DB_USER =
# BOOKS_DB_PASSWORD =
# BOOKS_DB_SCHEMA = public

# Shared secret for asking Manage whether a company still exists, used by
# <app>:find-orphan-companies. Must match MANAGE_PRODUCT_SERVICE_KEY in Manage's .env.
# Unset means the orphan check says so and exits non-zero rather than passing quietly.
MANAGE_PRODUCT_SERVICE_KEY =

# -------------------------------------------------------
# Console cron monitor (console.aicountly.org).
#
# A scheduled job reports itself to Console through App\Services\CronHeartbeat: a start, then an
# ok or an error. Console computes OVERDUE / STUCK / FAILING at read time, when somebody opens the
# console — there is no polling job watching the crons.
#
# LEAVE THIS UNSET on a developer machine and in any environment that is not meant to report.
# Unset means the emitter does nothing at all: no HTTP call, no log line. A laptop that reported
# would hold a production monitor green while the production cron was dead.
#
# The key must match what Console accepts. Console resolves the key it expects in this order:
#   1. CRON_MONITOR_KEY_HASH  (the SHA-256 of the key — the recommended form, and the one its own
#                              docblock tells you to deploy)
#   2. CRON_MONITOR_KEY       (the key itself)
#   3. CONSOLE_SERVICE_KEY    (the shared product-to-Console key)
#
# So CONSOLE_SERVICE_KEY works as a fallback here ONLY IF Console has neither CRON_MONITOR_KEY_HASH
# nor CRON_MONITOR_KEY set. If Console is deployed the recommended way, with the hash, and this
# host has only CONSOLE_SERVICE_KEY, the emitter looks configured and fires on every run — and
# Console answers 401 every time, the heartbeat is swallowed with a warning, and every monitor for
# this app reads OVERDUE for ever while every job runs perfectly. Set CONSOLE_CRON_MONITOR_KEY to
# the same plaintext key Console's CRON_MONITOR_KEY_HASH is the hash of.
# -------------------------------------------------------
CONSOLE_CRON_MONITOR_KEY =

# Override only for a rehearsal Console. Defaults to https://console.aicountly.org/api
# CONSOLE_API_BASE = https://console.aicountly.org/api
