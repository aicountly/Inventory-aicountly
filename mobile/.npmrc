# Expo's dependency tree lists react-dom/react-native-web as *optional* peers
# (for the `web` target we don't build). npm's default strict peer resolution
# still tries to satisfy their peer ranges against whatever is currently
# published on the registry, which breaks the install the moment a newer
# react-dom comes out requiring a newer react than the one this SDK pins —
# unrelated to anything this project actually uses. legacy-peer-deps skips
# that check instead of forcing everyone to pass --legacy-peer-deps by hand.
legacy-peer-deps=true
